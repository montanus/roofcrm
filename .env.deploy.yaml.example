# Copy this to .env.deploy.yaml (gitignored) and fill in real values.
# deploy.sh passes this straight to `gcloud run deploy --env-vars-file`, so it
# has to be valid YAML — quote any value with special characters.
#
# These become the actual Cloud Run environment for the service; they
# override whatever's baked into the image via .env at build time.

DB_SOCKET_PATH: "/cloudsql/PROJECT:REGION:INSTANCE"
DB_USER: "root"
DB_PASS: "changeme"
DB_SCHEMA: "reservation-sample"
APP_PASSWORD: "changeme"
NEXTAUTH_SECRET: "changeme"
NEXTAUTH_URL: "https://your-service-url.run.app/"
NEXT_PUBLIC_SITE_TITLE: "RL Spencer Roofing - CRM"
